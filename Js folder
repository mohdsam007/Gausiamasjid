/* =========================================
   GOSIYA MASJID - ADMIN PANEL SCRIPT
========================================= */

document.addEventListener("DOMContentLoaded", function () {

    const loginForm = document.getElementById("adminLoginForm");
    const adminLogin = document.getElementById("adminLogin");
    const adminDashboard = document.getElementById("adminDashboard");

    /*
       Demo login

       Super Admin:
       username: admin
       password: admin123

       Content Admin:
       username: imam
       password: imam123
    */

    if (loginForm) {

        loginForm.addEventListener("submit", function (event) {

            event.preventDefault();

            const username =
                document.getElementById("adminUsername").value.trim();

            const password =
                document.getElementById("adminPassword").value;

            const message =
                document.getElementById("adminLoginMessage");

            let role = "";

            if (
                username === "admin" &&
                password === "admin123"
            ) {
                role = "superadmin";
            }

            else if (
                username === "imam" &&
                password === "imam123"
            ) {
                role = "contentadmin";
            }

            if (role !== "") {

                localStorage.setItem(
                    "gosiyaAdminLoggedIn",
                    "true"
                );

                localStorage.setItem(
                    "gosiyaAdminRole",
                    role
                );

                showDashboard(role);

            } else {

                if (message) {
                    message.textContent =
                        "❌ Username या password गलत है।";
                }

            }

        });

    }


    /* Check existing login */

    const loggedIn =
        localStorage.getItem(
            "gosiyaAdminLoggedIn"
        );

    const savedRole =
        localStorage.getItem(
            "gosiyaAdminRole"
        );

    if (
        loggedIn === "true" &&
        savedRole
    ) {

        showDashboard(savedRole);

    }

});


/* =========================================
   SHOW DASHBOARD
========================================= */

function showDashboard(role) {

    const login =
        document.getElementById("adminLogin");

    const dashboard =
        document.getElementById("adminDashboard");

    if (login) {
        login.style.display = "none";
    }

    if (dashboard) {
        dashboard.style.display = "flex";
    }

    updateAdminRole(role);

    applyPermissions(role);

    openSection("dashboard");
}


/* =========================================
   UPDATE ADMIN NAME / ROLE
========================================= */

function updateAdminRole(role) {

    const name =
        document.getElementById("adminName");

    const roleText =
        document.getElementById("adminRole");

    if (role === "superadmin") {

        if (name) {
            name.textContent = "Super Admin";
        }

        if (roleText) {
            roleText.textContent =
                "Full Administrator";
        }

    }

    else if (role === "contentadmin") {

        if (name) {
            name.textContent = "Imam Admin";
        }

        if (roleText) {
            roleText.textContent =
                "Content Administrator";
        }

    }

}


/* =========================================
   ROLE PERMISSIONS
========================================= */

function applyPermissions(role) {

    const paymentMenu =
        document.querySelector(
            '[data-section="payments"]'
        );

    const settingsMenu =
        document.querySelector(
            '[data-section="settings"]'
        );


    /*
       Super Admin:
       Everything allowed
    */

    if (role === "superadmin") {

        if (paymentMenu) {
            paymentMenu.style.display = "flex";
        }

        if (settingsMenu) {
            settingsMenu.style.display = "flex";
        }

        return;
    }


    /*
       Content Admin:
       Payment और Settings restricted
    */

    if (role === "contentadmin") {

        if (paymentMenu) {
            paymentMenu.style.display = "none";
        }

        if (settingsMenu) {
            settingsMenu.style.display = "none";
        }

    }

}


/* =========================================
   OPEN SECTION
========================================= */

function openSection(sectionId) {

    const sections =
        document.querySelectorAll(
            ".admin-section"
        );

    const menuItems =
        document.querySelectorAll(
            ".menu-item"
        );


    sections.forEach(function (section) {

        section.classList.remove("active");

    });


    menuItems.forEach(function (item) {

        item.classList.remove("active");

    });


    const section =
        document.getElementById(sectionId);

    const menu =
        document.querySelector(
            `[data-section="${sectionId}"]`
        );


    if (section) {
        section.classList.add("active");
    }

    if (menu) {
        menu.classList.add("active");
    }


    updatePageTitle(sectionId);

    closeSidebar();
}


/* =========================================
   MENU BUTTONS
========================================= */

document.addEventListener(
    "click",
    function (event) {

        const menu =
            event.target.closest(
                ".menu-item"
            );

        if (!menu) {
            return;
        }

        const section =
            menu.getAttribute(
                "data-section"
            );

        if (section) {
            openSection(section);
        }

    }
);


/* =========================================
   PAGE TITLES
========================================= */

function updatePageTitle(sectionId) {

    const pageTitle =
        document.getElementById(
            "pageTitle"
        );

    if (!pageTitle) {
        return;
    }

    const titles = {

        dashboard: "Dashboard",

        namaz: "Namaz Timings",

        events: "Events",

        notices: "Notices",

        gallery: "Gallery",

        payments: "Payments",

        contacts: "Contacts",

        settings: "Settings"

    };

    pageTitle.textContent =
        titles[sectionId] ||
        "Dashboard";
}


/* =========================================
   SIDEBAR
========================================= */

function toggleSidebar() {

    const sidebar =
        document.querySelector(
            ".sidebar"
        );

    if (!sidebar) {
        return;
    }

    sidebar.classList.toggle("open");
}


function closeSidebar() {

    const sidebar =
        document.querySelector(
            ".sidebar"
        );

    if (!sidebar) {
        return;
    }

    sidebar.classList.remove("open");
}


/* =========================================
   LOGOUT
========================================= */

function adminLogout() {

    localStorage.removeItem(
        "gosiyaAdminLoggedIn"
    );

    localStorage.removeItem(
        "gosiyaAdminRole"
    );

    window.location.href =
        "index.html";
}


