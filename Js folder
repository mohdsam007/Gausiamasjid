/* =========================================
   NAMAZ SAVE
========================================= */

function saveNamaz() {

    const fajr =
        document.getElementById(
            "fajrTime"
        ).value;

    const zuhr =
        document.getElementById(
            "zuhrTime"
        ).value;

    const asr =
        document.getElementById(
            "asrTime"
        ).value;

    const maghrib =
        document.getElementById(
            "maghribTime"
        ).value;

    const isha =
        document.getElementById(
            "ishaTime"
        ).value;


    /*
       Demo storage.

       बाद में database से connect करेंगे।
    */

    localStorage.setItem(
        "namazTimings",
        JSON.stringify({
            fajr,
            zuhr,
            asr,
            maghrib,
            isha
        })
    );


    const message =
        document.getElementById(
            "namazMessage"
        );

    if (message) {

        message.textContent =
            "✅ Namaz timings saved successfully.";

    }

}


/* =========================================
   PAYMENT SAVE
========================================= */

function savePayments() {

    const role =
        localStorage.getItem(
            "gosiyaAdminRole"
        );


    /*
       Security check
    */

    if (role !== "superadmin") {

        alert(
            "🔒 आपको Payment Settings का access नहीं है।"
        );

        return;
    }


    const upi =
        document.getElementById(
            "upiId"
        ).value.trim();

    const account =
        document.getElementById(
            "accountName"
        ).value.trim();

    const info =
        document.getElementById(
            "paymentInfo"
        ).value.trim();


    localStorage.setItem(
        "paymentSettings",
        JSON.stringify({
            upi,
            account,
            info
        })
    );


    alert(
        "✅ Payment settings saved."
    );

}
